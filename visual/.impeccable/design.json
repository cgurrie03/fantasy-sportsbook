  "narrative": {
    "northStar": "Forest & Ivory",
    "overview": "Forest & Ivory pairs a quiet off-white canvas and white panels with a persistent forest identity. Restrained Newsreader headings give league content an editorial character; Public Sans carries navigation, market labels, prices, and forms.\n\nThe identity is lowercase boff with the provisional serif B monogram. Market rows favor aligned prices, real team names, and compact borders. This records the visual frontend as implemented; desktop review precedes later owner mobile iteration.",
    "keyCharacteristics": [
      "Forest rail and off-white canvas.",
      "Newsreader headings with Public Sans operations.",
      "Sage selection plus a checkmark.",
      "Flat bordered panels and contextual overlays."
    ],
    "rules": [
      {
        "name": "The Selection Rule",
        "body": "Use sage with forest ink and a checkmark for selected prices, preserving the selection cue in both themes.",
        "section": "colors"
      },
      {
        "name": "The Operational Type Rule",
        "body": "Use Public Sans for prices, navigation, labels, and controls; reserve Newsreader for editorial headings and the wordmark.",
        "section": "typography"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Keep market and form panels flat; use shadows for floating menus, dialogs, and feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve lowercase boff and the provisional B identity.",
      "Do align market prices and use tabular numerals for numeric controls.",
      "Do allow long real team names to wrap.",
      "Do preserve visible keyboard focus and reduced-motion behavior."
    ],
    "donts": [
      "Don't substitute a system display font for Newsreader.",
      "Don't use brass as the default selected-price fill.",
      "Don't give ordinary market panels overlay shadows.",
      "Don't present local preview actions as completed backend operations."
    ]
  }
