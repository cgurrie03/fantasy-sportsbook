{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/weekly-worker.ts": { "maxDuration": 120 },
    "api/reopening-review.ts": { "maxDuration": 120 },
    "api/generate-markets.ts": { "maxDuration": 120 }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
